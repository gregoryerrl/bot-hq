# bot-hq — environment configuration
# Copy to .env (gitignored) and edit. Variables here are read at startup.

# =============================================================================
# Data directory
# =============================================================================
# Override the default CL + DB location. Defaults to ~/.bot-hq/, which is what
# development runs against too — leave this commented out unless you need a
# second data dir.
#
# Uncomment (and point somewhere else) if you run an INSTALLED bot-hq release
# alongside a source build: both default to ~/.bot-hq/ and would share one
# Context Library, sqlite DB, and single-instance lock.
# BOT_HQ_DATA_DIR=~/.bot-hq-dev/

# =============================================================================
# External MCP server (drive bot-hq from another agent)
# =============================================================================
# The external MCP driver server was REMOVED on 2026-08-17 and demoted to a
# future plugin, so the BOT_HQ_EXTERNAL_MCP_* variables that lived here are gone.
# See ARCHITECTURE.md, "The external driver — REMOVED".

# =============================================================================
# Live tests
# =============================================================================
# Phase 2.5 and Phase 3.5 smoke tests spawn a real claude-code subprocess.
# Set this to "1" before running `cargo test` to include them.
# RUN_LIVE_TESTS=1

# =============================================================================
# Agent credentials
# =============================================================================
# Per-agent provider/model/auth_token live in the agent_configs sqlite table,
# edited from the Settings tab. The Anthropic default below is only used as a
# fallback if a row is missing — and the Settings UI is the canonical surface.
# ANTHROPIC_API_KEY=sk-ant-api03-…

# =============================================================================
# Logging
# =============================================================================
# tracing-subscriber EnvFilter. Defaults to "info,bot_hq=debug".
# RUST_LOG=info,bot_hq=debug
