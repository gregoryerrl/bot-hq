#!/usr/bin/env bash
# Launch bot-hq in one step.
#
#   ./start              debug build, rebuild the frontend first
#   ./start --release    release build (slower; what you ship)
#   ./start --fast       skip the frontend build (only when frontend/ is untouched)
#   ./start --stop       stop a running instance and exit
#
# Why this exists rather than "cargo run": the binary EMBEDS frontend/dist, so a
# bare cargo build bakes whatever dist happens to be on disk. That ships an app
# with a stale — or purged, ~5 KB instead of ~37 KB — stylesheet, and it looks
# like a CSS bug rather than a build-order bug. The frontend build has to come
# first, every time.

set -euo pipefail

cd "$(dirname "$0")"
DATA_DIR="${BOT_HQ_DATA_DIR:-$HOME/.bot-hq}"
LOCK="$DATA_DIR/.local/lock"
PROFILE=debug
SKIP_FRONTEND=0

for arg in "$@"; do
  case "$arg" in
    --release) PROFILE=release ;;
    --fast)    SKIP_FRONTEND=1 ;;
    --stop)    PROFILE=stop ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $arg (try --help)" >&2; exit 2 ;;
  esac
done

say() { printf '\033[1;36m▸\033[0m %s\n' "$1"; }
die() { printf '\033[1;31m✗\033[0m %s\n' "$1" >&2; exit 1; }

stop_running() {
  # Match the built binaries specifically — a bare "bot-hq" pattern also matches
  # this script, an editor, or a shell sitting in the repo.
  local pids
  pids=$(pgrep -f 'target/(debug|release)/bot-hq$' || true)
  if [[ -n "$pids" ]]; then
    say "stopping running instance ($(echo "$pids" | tr '\n' ' '))"
    kill $pids 2>/dev/null || true
    for _ in $(seq 1 20); do
      pgrep -f 'target/(debug|release)/bot-hq$' >/dev/null || break
      sleep 0.5
    done
    pgrep -f 'target/(debug|release)/bot-hq$' >/dev/null \
      && die "it did not exit — kill it by hand before retrying"
  fi
  # Single-instance lock. Safe to clear only once nothing is running, which is
  # exactly where we are; a kill -9 leaves this behind and the next launch then
  # refuses to start with no obvious reason.
  [[ -f "$LOCK" ]] && { rm -f "$LOCK"; say "cleared the stale instance lock"; }
  return 0
}

if [[ "$PROFILE" == "stop" ]]; then
  stop_running
  say "stopped"
  exit 0
fi

stop_running

if [[ "$SKIP_FRONTEND" -eq 1 ]]; then
  [[ -d frontend/dist ]] || die "--fast needs an existing frontend/dist; run without it once"
  say "skipping the frontend build (--fast)"
else
  say "building the frontend"
  ( cd frontend && npm run build ) >/dev/null 2>&1 \
    || { ( cd frontend && npm run build ); die "frontend build failed (output above)"; }

  # The stale-dist trap has a tell: a purged stylesheet is ~5 KB where a real one
  # is ~37 KB. Cheap to check, and it catches the failure BEFORE you spend a
  # release build and then wonder why the app is unstyled.
  css=$(find frontend/dist/assets -name '*.css' -print -quit 2>/dev/null || true)
  if [[ -n "$css" ]]; then
    bytes=$(wc -c < "$css" | tr -d ' ')
    if (( bytes < 15000 )); then
      die "frontend/dist stylesheet is only ${bytes}B — Tailwind purged nearly everything. Fix the build; do not ship this."
    fi
    say "frontend ok ($(( bytes / 1024 )) KB stylesheet)"
  fi
fi

if [[ "$PROFILE" == "release" ]]; then
  say "building release (this embeds the dist just built)"
  cargo build --release
  BIN=target/release/bot-hq
else
  say "building debug"
  cargo build
  BIN=target/debug/bot-hq
fi

[[ -x "$BIN" ]] || die "$BIN is missing after a successful build — that should not happen"

say "starting bot-hq"
exec "$BIN"
